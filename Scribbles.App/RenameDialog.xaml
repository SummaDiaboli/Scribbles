<Window x:Class="Scribbles.App.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppForeground}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="New name:" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Padding="6,4" />
        <TextBlock Text=".pdf extension is kept automatically." Opacity="0.7" FontSize="11" Margin="0,4,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="76" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="76" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
