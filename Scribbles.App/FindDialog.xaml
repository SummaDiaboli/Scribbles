<Window x:Class="Scribbles.App.FindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find in document" Width="360"
        SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppForeground}">
    <StackPanel Margin="12">
        <TextBox x:Name="QueryBox" Padding="6,4" ToolTip="Type to search. Enter finds next, Shift+Enter finds previous."/>
        <TextBlock x:Name="CountText" Margin="0,4,0,0" FontSize="11" Opacity="0.7"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Previous" Width="76" Margin="0,0,8,0" Click="Prev_Click"/>
            <Button Content="Next" Width="76" Margin="0,0,8,0" IsDefault="True" Click="Next_Click"/>
            <Button Content="Close" Width="76" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
