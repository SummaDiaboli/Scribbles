<Window x:Class="Scribbles.App.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scribbles" Height="560" Width="860"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource AppForeground}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="New notebook" Padding="14,6" Margin="0,0,8,0" Click="NewNotebook_Click"/>
                <Button Content="Open PDF…" Padding="14,6" Margin="0,0,8,0" Click="OpenPdf_Click"/>
                <Button Content="Import slides…" Padding="14,6" Click="ImportSlides_Click"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppBackground}">
            <ItemsControl x:Name="DocumentList" Margin="12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="168" Margin="8" Padding="8" Cursor="Hand"
                                Background="{DynamicResource AppSurface}"
                                BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8"
                                MouseLeftButtonUp="Card_Open" ToolTip="{Binding Path}">
                            <StackPanel>
                                <Border Height="150" Background="{DynamicResource AppBackground}" CornerRadius="4">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
