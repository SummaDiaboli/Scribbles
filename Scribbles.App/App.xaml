<Application x:Class="Scribbles.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Scribbles.App;component/Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="/Scribbles.App;component/Themes/Icons.xaml"/>
                <ResourceDictionary Source="/Scribbles.App;component/Themes/SystemBrushes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
