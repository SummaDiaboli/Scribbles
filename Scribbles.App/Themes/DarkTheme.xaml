<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#1E1E1E</Color>
    <Color x:Key="AppSurfaceColor">#2D2D2D</Color>
    <Color x:Key="AppForegroundColor">#F3F3F3</Color>
    <Color x:Key="AppAccentColor">#4CC2FF</Color>
    <Color x:Key="AppOnAccentColor">#101010</Color>
    <Color x:Key="AppBorderColor">#3F3F3F</Color>
    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="AppSurface" Color="{StaticResource AppSurfaceColor}"/>
    <SolidColorBrush x:Key="AppForeground" Color="{StaticResource AppForegroundColor}"/>
    <SolidColorBrush x:Key="AppAccent" Color="{StaticResource AppAccentColor}"/>
    <SolidColorBrush x:Key="AppOnAccent" Color="{StaticResource AppOnAccentColor}"/>
    <SolidColorBrush x:Key="AppBorder" Color="{StaticResource AppBorderColor}"/>
</ResourceDictionary>
